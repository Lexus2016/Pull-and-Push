{
  "id": "btcusdt-futures",
  "name": "BTCUSDT 5m futures strategy",
  "keywords": ["trading", "btc", "btcusdt", "futures", "crypto", "binance", "strategy",
               "backtest", "sharpe", "drawdown", "leverage", "trade", "bot"],
  "summary": "Tune a leveraged long/short BTCUSDT 5m strategy. The executor edits strategy.py (a PARAMS dict); a committed backtest harness scores total return, liquidations and drawdown on real data.",
  "config": {
    "mode": "asymmetric",
    "agents": {"executor": {"engine": "claude", "timeout": 600},
               "validator": {"engine": "claude", "timeout": 300}},
    "roles": {
      "executor": {"task": "Edit ONLY strategy.py — tune the PARAMS dict values. Do NOT modify or run anything under metrics/. One focused change per step."},
      "validator": {"goal": "Say why the score moved and suggest one concrete PARAMS change."}
    },
    "evaluation": {
      "adapter": "numeric",
      "command": "python ../metrics/run_backtest.py --strategy strategy.py --symbol BTCUSDT",
      "target_score": 90,
      "metrics": [
        {"name": "total_return_pct", "dir": "higher", "weight": 0.5, "target": 300},
        {"name": "liquidations", "dir": "lower", "weight": 0.25, "target": 0},
        {"name": "max_drawdown_pct", "dir": "lower", "weight": 0.2, "target": 30},
        {"name": "max_drawdown_days", "dir": "lower", "weight": 0.15, "target": 5}
      ]
    },
    "limits": {"max_iterations": 40, "plateau_N": 8, "step_seconds": 600},
    "sandbox": {"backend": "local"}
  }
}
